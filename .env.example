# --- Database (the only required stateful dependency) ---------------------
# Production: a Postgres 16+ connection string (AWS RDS is the recommended default).
#   DATABASE_URL=postgres://user:pass@host:5432/breadboard
#   DATABASE_SSL=require            # disable | prefer | require | verify-full
#   DATABASE_SSL_CA_FILE=/path/rds-ca.pem
#   DATABASE_IAM_AUTH=false         # true => mint RDS IAM auth tokens from the AWS credential chain
# Dev / quickstart: an embedded in-process Postgres (PGlite) at a directory, or in-memory.
DATABASE_URL=pglite://./var/db
#DATABASE_URL=pglite://memory

# --- Server --------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# --- Config repo (configuration plane) -----------------------------------
CONFIG_REPO_DIR=./var/config-repo          # bare git repo managed by the server
CONFIG_WORKTREE_CACHE_DIR=./var/config-trees
CONFIG_SEED_DIR=./config-seed              # copied into a fresh repo on first boot

# --- Object storage -------------------------------------------------------
OBJECT_STORE=fs                            # fs | s3
OBJECT_STORE_DIR=./var/objects
#OBJECT_STORE_S3_BUCKET=
#OBJECT_STORE_S3_PREFIX=breadboard/

# --- Model gateway --------------------------------------------------------
MODEL_PROVIDER=mock                        # bedrock | mock  (mock is for local dev / tests)
AWS_REGION=us-east-1
#BEDROCK_ENDPOINT=

# --- Tool sandbox ---------------------------------------------------------
SANDBOX_RUNNER=process                     # docker | process  (process = unisolated local fallback, dev only)
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_OCI_RUNTIME=                       # e.g. runsc for gVisor
SANDBOX_WARM_POOL_SIZE=2
SANDBOX_EGRESS_PROXY_PORT=4100
#SANDBOX_EGRESS_PROXY_HOST=host.docker.internal  # how tool containers address the proxy
#SANDBOX_API_URL=                          # API base URL for tool code; defaults to PUBLIC_URL

# --- Secrets --------------------------------------------------------------
# With NODE_ENV=production the server refuses to start unless both keys below hold real values.
# 32-byte base64 master key for the credential broker (libsodium secretbox): openssl rand -base64 32
BROKER_MASTER_KEY=
# HMAC key for user/session/actor tokens, at least 32 characters in production: openssl rand -hex 32
TOKEN_SIGNING_KEY=dev-only-change-me
# Break-glass admin sign-in (user `bootstrap-admin`). With NODE_ENV=production the seed's `*-change-me` tokens are
# refused, so set this to sign in to a fresh deployment and configure OIDC.
#BREADBOARD_BOOTSTRAP_ADMIN_TOKEN=
